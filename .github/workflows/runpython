name: Python Projesi Çalıştır

on:
  push:
    branches: [ "main" ]
  pull_request:
    branches: [ "main" ]
  workflow_dispatch: # GitHub arayüzünden manuel tetikleme sağlar

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
    - name: Kodu sunucuya çek (Checkout)
      uses: actions/checkout@v4

    - name: Python ortamını kur
      uses: actions/setup-python@v5
      with:
        python-version: '3.11' # Kullanmak istediğiniz sürüm

    - name: Bağımlılıkları yükle
      run: |
        python -m pip install --upgrade pip
        if [ -f requirements.txt ]; then pip install -r requirements.txt; fi

    - name: Python betiğini çalıştır
      run: python app.py
