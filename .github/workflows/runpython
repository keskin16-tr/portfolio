name: Python App CI

# Tetiklenecek olaylar (Hangi durumlarda çalışacağı)
on:
  push:
    branches: [ "main", "master" ] # main veya master branch'ine push yapıldığında
  pull_request:
    branches: [ "main", "master" ]

jobs:
  build:
    runs-on: ubuntu-latest # Çalışacağı sunucu ortamı

    steps:
    # 1. Adım: Proje kodunu runner'a (sunucuya) çekme
    - name: Depodaki Kodları Al
      uses: actions/checkout@v4

    # 2. Adım: Python ortamını kurma
    - name: Python Kur
      uses: actions/setup-python@v5
      with:
        python-version: '3.10' # Projenizin kullandığı Python sürümünü buraya yazabilirsiniz (örn: 3.11, 3.12)
        cache: 'pip' # Pip paket yöneticisi önbelleklemesi

    # 3. Adım: Gerekli kütüphaneleri (bağımlılıkları) yükleme
    - name: Bağımlılıkları Yükle
      run: |
        python -m pip install --upgrade pip
        if [ -f requirements.txt ]; then
          pip install -r requirements.txt
        fi

    # 4. Adım: app.py dosyasını çalıştırma
    - name: app.py Dosyasını Çalıştır
      run: |
        python app.py
